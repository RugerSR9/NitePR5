# NitePR5 — ignore build artifacts, secrets, and local console/PC data.
# Keep source, docs, AGENTS.md, and .cursor/rules tracked.

# --- OS ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store

# --- Editors / IDEs ---
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*~

# --- Secrets / local env ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python (web UI / nitepr5-core) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.cache/

# --- Node (not required for v1; ignore if added later) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- C / CMake / PS5 payload SDK (plugin, overlay) ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
compile_commands.json
CMakeUserPresets.json
out/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.elf
*.plugin
*.prx
*.self
*.bin
!web/static/**

# --- Logs ---
*.log
logs/

# --- Local editor / scan data (do not commit dumps or live cheats) ---
web/cheats/**
!web/cheats/.gitkeep
web/dumps/
*.dump
*.ram
scripts/ps5_ip.txt
.ps5debug-host
